Pesquisa/dados/processados/medqa.json
Pesquisa/scripts/construir_indices.log
# Fragmentos exportados e vetores do Colab (grandes; exportar_fragmentos.py recria)
Pesquisa/colab/*.gz
Pesquisa/colab/*.zip
